# ============================================
# AI-POWERED CONTENT SUMMARIZER — ENV CONFIG
# ============================================

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-summarizer?retryWrites=true&w=majority

# Google Gemini API (primary AI provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Claude / Anthropic API (optional fallback)
CLAUDE_API_KEY=your_claude_api_key_here

# LangSmith Tracing (optional — for observability)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="genai"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
